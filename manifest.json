{
  "manifest_version": 3,
  "name": "STRIDE Inventory Helper",
  "version": "0.5.25",
  "content_scripts": [{
    "matches": ["https://stridecsgo.net/*"],
    "js": ["skin-patterns.js", "skin-cards.js"],
    "css": ["skin-cards.css"]
  }],
  "optional_host_permissions": ["https://stridecsgo.net/*"],
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "stride-inventory-helper@smelbravo", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
